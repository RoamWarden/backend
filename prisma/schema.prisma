// RoamWarden data model — see RoamWarden-Build-Plan.pdf §9.
//
// Geospatial columns use PostGIS geography(SRID 4326) via Prisma `Unsupported`
// types. They are nullable so the generated client stays fully usable; services
// populate them with raw SQL in the same transaction as the row write, and all
// geo queries (corridor matching, radius search, bbox) go through
// $queryRaw/$executeRaw.
//
// Plain lat/lng float columns sit alongside each geography column so reads
// never need PostGIS round-trips.
//
// ── GiST indexes are DECLARED HERE. Do not hand-write them again. ───────────
// Every geography column carries a GiST index. These used to be added by hand
// in raw SQL because the datamodel could not express them — so Prisma could not
// SEE them, and every generated migration opened by DROPping all five, plus the
// `DEFAULT ARRAY[]::TEXT[]` on plans.features and sos_escalations.contact_order.
// The only defence was a human deleting those lines from each new migration by
// hand, and applying even one would have quietly turned every corridor / radius
// / bbox query into a sequential scan. No error — just a database getting
// slower forever.
//
// They are now `@@index([...], type: Gist, map: "<original name>")` on the
// models below, and `@default([])` on the two array columns, so the datamodel
// matches the database and the diff comes back clean. `map:` pins the ORIGINAL
// index names — changing one renames a live production index.
//
// IF A GENERATED MIGRATION EVER CONTAINS `DROP INDEX ..._gix`, OR
// `ALTER COLUMN ... DROP DEFAULT` on those two columns, do NOT hand-strip it:
// it means a declaration below was lost and the schema has drifted again. Fix
// the model instead. `src/prisma/migration-safety.spec.ts` fails the build if
// such a migration is ever committed.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "debian-openssl-3.0.x", "darwin-arm64"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// ─────────────────────────────── enums ───────────────────────────────

enum TransportMode {
  CAR
  BUS
  MOTORBIKE
  TRAIN
  WALK
  BICYCLE
  OTHER

  @@map("transport_mode")
}

enum TripStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  SOS

  @@map("trip_status")
}

enum ReportType {
  ROBBERY
  HOLD_UP
  ACCIDENT
  CHECKPOINT
  UNREST
  BAD_ROAD
  LOST_ITEM
  OTHER

  @@map("report_type")
}

enum ReportStatus {
  UNCONFIRMED
  VERIFIED
  REJECTED
  EXPIRED
  REMOVED

  @@map("report_status")
}

enum AlertChannel {
  WEBSOCKET
  PUSH

  @@map("alert_channel")
}

enum DevicePlatform {
  IOS
  ANDROID

  @@map("device_platform")
}

/// Lifecycle of a user's single subscription row (build plan §20).
/// FREE      — on the free tier. Also what "no subscription row at all" means.
/// PENDING   — a paid plan was selected but nothing has been paid. NO entitlements.
/// ACTIVE    — paid and in good standing. ONLY a payment gateway may set this.
/// CANCELLED — cancelled by the user; may still run out its paid period.
/// EXPIRED   — a paid period lapsed without renewal.
enum SubscriptionStatus {
  FREE
  PENDING
  ACTIVE
  CANCELLED
  EXPIRED

  @@map("subscription_status")
}

/// Role inside a family/group plan. There are only two: the OWNER (exactly one
/// per group, the account whose plan supplies the seats) and MEMBER. The owner
/// also holds a `group_members` row, so seat counting is a single COUNT and the
/// roster needs no special case.
enum GroupMemberRole {
  OWNER
  MEMBER

  @@map("group_member_role")
}

/// Lifecycle of a group invitation.
/// PENDING  — sent, awaiting the invitee. Only actionable while `expiresAt` is
///            in the future; expiry is computed, never a background job.
/// ACCEPTED — the invitee opted in and a `group_members` row exists.
/// DECLINED — the invitee said no. Re-inviting reuses (resets) the same row.
/// REVOKED  — the owner withdrew it before it was answered.
enum GroupInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED

  @@map("group_invite_status")
}

// ─────────────────────────────── identity ───────────────────────────────

model User {
  id              String    @id @default(uuid()) @db.Uuid
  // Nullable: Google-only accounts have a googleSub and no passwordHash;
  // email/password accounts have a passwordHash and no googleSub. Either
  // identity keys the same email-unique user row.
  googleSub       String?   @unique @map("google_sub")
  passwordHash    String?   @map("password_hash")
  isAdmin         Boolean   @default(false) @map("is_admin")
  // Null until the email is proven: email/password accounts verify via a 6-digit
  // OTP; Google accounts arrive pre-verified (Google asserts email_verified).
  emailVerifiedAt DateTime? @map("email_verified_at")
  email           String    @unique
  name            String
  avatarUrl       String?   @map("avatar_url")
  phone           String?
  reputation      Int       @default(0)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  emailVerifications  EmailVerificationOtp[]
  trustedContacts     TrustedContact[]       @relation("owner")
  linkedAsContact     TrustedContact[]       @relation("contactUser")
  // The owner's own labels over their contact list ("Family", "Work"). Private
  // to this account — see the ContactGroup model.
  contactGroups       ContactGroup[]
  trips               Trip[]
  reports             Report[]
  reportVotes         ReportVote[]
  alerts              Alert[]
  deviceTokens        DeviceToken[]
  sosEvents           SosEvent[]
  // At most one subscription per user (enforced by a UNIQUE on subscriptions.user_id).
  // Absent = the user is on the free tier; we never backfill a row for everyone.
  subscription        Subscription?
  // Family/group plan (build plan §20, Premium capability `familyPlan`).
  // At most ONE owned group per user (UNIQUE on groups.owner_id); being a
  // MEMBER of other people's groups is unbounded.
  //
  // READ THIS: neither of these relations grants any access to this user's
  // location, trips, presence, SOS events, email or phone. Group membership is
  // a roster and nothing else — live location still flows only through
  // TrustedContact + UsersService.filterConsentingContactUserIds. See
  // src/resources/group/groups.service.ts.
  ownedGroup          Group?
  groupMemberships    GroupMember[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// One-time 6-digit email-verification codes. Stored only as a keyed (HMAC) hash
// — the tiny 10^6 keyspace makes a plain hash brute-forceable, so we key it with
// a server secret. Single-use (consumedAt), short-lived (expiresAt), and
// attempt-limited (attemptCount) to defeat guessing.
model EmailVerificationOtp {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  codeHash     String    @map("code_hash")
  expiresAt    DateTime  @map("expires_at")
  attemptCount Int       @default(0) @map("attempt_count")
  consumedAt   DateTime? @map("consumed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_otps")
}

// Early-access waitlist (landing-page signups). Not tied to a user account.
model WaitlistEntry {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  source    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("waitlist_entries")
}

model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash")
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  replacedByTokenId String?   @map("replaced_by_token_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model TrustedContact {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  contactUserId String?  @map("contact_user_id") @db.Uuid
  name          String
  phone         String?
  email         String?
  relation      String?
  // "Pin this person to the top of my list." Purely a display preference — it
  // grants no extra reach, no priority in an SOS fan-out and no consent. It
  // defaults to false so every existing row is valid the instant the column
  // lands, which is what makes the migration safe to apply before the deploy.
  favorite      Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at")

  user             User                 @relation("owner", fields: [userId], references: [id], onDelete: Cascade)
  contactUser      User?                @relation("contactUser", fields: [contactUserId], references: [id], onDelete: SetNull)
  watching         TripWatcher[]
  groupMemberships ContactGroupMember[]

  @@unique([userId, contactUserId])
  @@index([userId])
  @@map("trusted_contacts")
}

/// A user's own label for a subset of their trusted contacts ("Family",
/// "Work"). PRIVATE TO THE OWNER and nothing like the family-plan `Group`
/// above: no other account can see it, join it, or be notified because of it.
/// It is a folder over rows the owner already has, so it grants no new reach —
/// live location still flows only through TrustedContact under the mutual
/// consent rule (UsersService.filterConsentingContactUserIds).
model ContactGroup {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  favorite  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  members ContactGroupMember[]

  // One name per owner, enforced by the database — two groups both called
  // "Family" would be indistinguishable in the picker.
  @@unique([userId, name])
  @@index([userId])
  @@map("contact_groups")
}

/// Join row: contact X is in group Y. The composite primary key makes a double
/// insert impossible, and BOTH sides cascade — deleting a group drops only
/// these rows (never the contacts), and deleting a contact quietly removes it
/// from every group it was filed under.
model ContactGroupMember {
  groupId   String @map("group_id") @db.Uuid
  contactId String @map("contact_id") @db.Uuid

  group   ContactGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  contact TrustedContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([groupId, contactId])
  @@map("contact_group_members")
}

model DeviceToken {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  token      String         @unique
  platform   DevicePlatform
  createdAt  DateTime       @default(now()) @map("created_at")
  lastSeenAt DateTime       @default(now()) @map("last_seen_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

// ─────────────────────────────── trips ───────────────────────────────

model Trip {
  id                String                                 @id @default(uuid()) @db.Uuid
  userId            String                                 @map("user_id") @db.Uuid
  mode              TransportMode
  status            TripStatus                             @default(ACTIVE)
  originLabel       String?                                @map("origin_label")
  destLabel         String?                                @map("dest_label")
  originLat         Float                                  @map("origin_lat")
  originLng         Float                                  @map("origin_lng")
  destLat           Float                                  @map("dest_lat")
  destLng           Float                                  @map("dest_lng")
  origin            Unsupported("geography(Point, 4326)")?
  destination       Unsupported("geography(Point, 4326)")?
  startedAt         DateTime                               @default(now()) @map("started_at")
  endedAt           DateTime?                              @map("ended_at")
  durationS         Int?                                   @map("duration_s")
  expectedDurationS Int?                                   @map("expected_duration_s")
  // Bumped whenever a fresh share token is issued; embedded in the token and
  // checked on the live view, so reissuing revokes every prior share link.
  shareTokenVersion Int                                    @default(0) @map("share_token_version")
  // No-arrival / stall escalation state (build plan §13#4). lastPointAt tracks
  // the freshest breadcrumb; checkinAt records an "I'm OK" response;
  // overdueNotifiedAt/escalatedAt gate the escalation ladder so it fires once.
  lastPointAt       DateTime?                              @map("last_point_at")
  checkinAt         DateTime?                              @map("checkin_at")
  overdueNotifiedAt DateTime?                              @map("overdue_notified_at")
  escalatedAt       DateTime?                              @map("escalated_at")
  createdAt         DateTime                               @default(now()) @map("created_at")
  updatedAt         DateTime                               @updatedAt @map("updated_at")

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  points    TripPoint[]
  route     TripRoute?
  watchers  TripWatcher[]
  alerts    Alert[]
  sosEvents SosEvent[]

  @@index([userId, status])
  @@index([status])
  // GiST on a PostGIS `geography` column. Declared here — with `map:` pinning
  // the ORIGINAL hand-written name — so the datamodel matches the database.
  // Before this, Prisma could not see the index and every `migrate diff`
  // proposed DROPping it, which would have turned every corridor/radius/bbox
  // query into a sequential scan the first time someone applied the diff.
  @@index([origin], type: Gist, map: "trips_origin_gix")
  @@index([destination], type: Gist, map: "trips_destination_gix")
  @@map("trips")
}

model TripPoint {
  id         BigInt                                 @id @default(autoincrement())
  tripId     String                                 @map("trip_id") @db.Uuid
  lat        Float
  lng        Float
  speed      Float?
  heading    Float?
  accuracy   Float?
  recordedAt DateTime                               @map("recorded_at")
  geog       Unsupported("geography(Point, 4326)")?

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, recordedAt])
  // GiST on a PostGIS `geography` column. Declared here — with `map:` pinning
  // the ORIGINAL hand-written name — so the datamodel matches the database.
  // Before this, Prisma could not see the index and every `migrate diff`
  // proposed DROPping it, which would have turned every corridor/radius/bbox
  // query into a sequential scan the first time someone applied the diff.
  @@index([geog], type: Gist, map: "trip_points_geog_gix")
  @@map("trip_points")
}

model TripRoute {
  tripId    String                                      @id @map("trip_id") @db.Uuid
  path      Unsupported("geography(LineString, 4326)")?
  source    String? // 'directions' | 'straight_line'
  updatedAt DateTime                                    @updatedAt @map("updated_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  // GiST on a PostGIS `geography` column. Declared here — with `map:` pinning
  // the ORIGINAL hand-written name — so the datamodel matches the database.
  // Before this, Prisma could not see the index and every `migrate diff`
  // proposed DROPping it, which would have turned every corridor/radius/bbox
  // query into a sequential scan the first time someone applied the diff.
  @@index([path], type: Gist, map: "trip_routes_path_gix")
  @@map("trip_routes")
}

model TripWatcher {
  id         String    @id @default(uuid()) @db.Uuid
  tripId     String    @map("trip_id") @db.Uuid
  contactId  String    @map("contact_id") @db.Uuid
  notifiedAt DateTime? @map("notified_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  trip    Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  contact TrustedContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([tripId, contactId])
  @@map("trip_watchers")
}

// ─────────────────────────────── community reports ───────────────────────────────

model Report {
  id            String                                 @id @default(uuid()) @db.Uuid
  reporterId    String                                 @map("reporter_id") @db.Uuid
  type          ReportType
  status        ReportStatus                           @default(UNCONFIRMED)
  lat           Float
  lng           Float
  geog          Unsupported("geography(Point, 4326)")?
  note          String?
  confirmCount  Int                                    @default(0) @map("confirm_count")
  denyCount     Int                                    @default(0) @map("deny_count")
  createdAt     DateTime                               @default(now()) @map("created_at")
  expiresAt     DateTime                               @map("expires_at")
  // Moderation audit (build plan §16/§17). Set when an admin removes a report;
  // removedById is a plain admin user id (no FK back-relation on purpose).
  removedById   String?                                @map("removed_by_id") @db.Uuid
  removedReason String?                                @map("removed_reason")
  removedAt     DateTime?                              @map("removed_at")

  reporter User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  votes    ReportVote[]
  alerts   Alert[]

  @@index([status, expiresAt])
  @@index([reporterId])
  // GiST on a PostGIS `geography` column. Declared here — with `map:` pinning
  // the ORIGINAL hand-written name — so the datamodel matches the database.
  // Before this, Prisma could not see the index and every `migrate diff`
  // proposed DROPping it, which would have turned every corridor/radius/bbox
  // query into a sequential scan the first time someone applied the diff.
  @@index([geog], type: Gist, map: "reports_geog_gix")
  @@map("reports")
}

model ReportVote {
  reportId  String   @map("report_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  vote      Int // +1 confirm, -1 deny
  createdAt DateTime @default(now()) @map("created_at")

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([reportId, userId])
  @@map("report_votes")
}

model Alert {
  id          String       @id @default(uuid()) @db.Uuid
  reportId    String       @map("report_id") @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  tripId      String?      @map("trip_id") @db.Uuid
  channel     AlertChannel
  deliveredAt DateTime     @default(now()) @map("delivered_at")

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip   Trip?  @relation(fields: [tripId], references: [id], onDelete: SetNull)

  @@unique([reportId, userId, channel])
  @@index([userId])
  @@map("alerts")
}

// ─────────────────────────────── SOS ───────────────────────────────

model SosEvent {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tripId     String?   @map("trip_id") @db.Uuid
  lat        Float?
  lng        Float?
  message    String?
  createdAt  DateTime  @default(now()) @map("created_at")
  /// The traveller said they are SAFE. The SOS happened and stands.
  resolvedAt DateTime? @map("resolved_at")

  // ── retraction (the traveller WITHDREW the alert) ──────────────────────
  //
  // Deliberately NOT the same thing as `resolvedAt`. "I'm safe now" closes an
  // SOS that really happened; "I withdraw this" says it should never have gone
  // out. Both stop the paging; only one carries a reputation cost, and only one
  // makes us go back and tell the contacts we already alarmed to stand down.
  //
  /// When the traveller withdrew this SOS. NULL = never withdrawn.
  retractedAt       DateTime? @map("retracted_at")
  /// Optional free-text reason the traveller gave, forwarded verbatim to the
  /// contacts who were already reached ("pocket dial", "false alarm, sorry").
  retractReason     String?   @map("retract_reason")
  /// RECEIPT for the one-time reputation dent: the penalty actually written to
  /// `users.reputation` for this retraction. NULL means no dent was applied —
  /// either this SOS was never retracted, or the reputation write failed and we
  /// chose not to lie about it. Never used to compute anything; it exists so
  /// "was this person charged twice?" has an answer.
  reputationPenalty Int?      @map("reputation_penalty")

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip       Trip?          @relation(fields: [tripId], references: [id], onDelete: SetNull)
  deliveries SosDelivery[]
  escalation SosEscalation?

  @@index([userId])
  // Retraction asks "is any OTHER SOS on this trip still live?" before it hands
  // the trip back to ACTIVE. A foreign key does not index itself in Postgres.
  @@index([tripId])
  @@map("sos_events")
}

/// Outcome of ONE attempt to reach ONE contact about ONE SOS.
/// SENT         — handed to the push provider (delivery to the handset is not guaranteed).
/// NO_DEVICE    — the contact has no registered device, so there was nothing to deliver to.
/// FAILED       — the attempt itself errored.
/// SKIPPED      — deliberately not attempted (e.g. already acknowledged).
/// ACKNOWLEDGED — the contact told us they saw it.
enum SosDeliveryStatus {
  SENT
  NO_DEVICE
  FAILED
  SKIPPED
  ACKNOWLEDGED

  @@map("sos_delivery_status")
}

/// How an attempt was carried (PUSH = FCM, REALTIME = live socket fan-out).
enum SosDeliveryChannel {
  PUSH
  REALTIME

  @@map("sos_delivery_channel")
}

/// Lifecycle of the Priority-SOS escalation ladder for one SOS event.
/// RUNNING      — still working through the contact list.
/// ACKNOWLEDGED — a contact confirmed they saw it; paging stops.
/// RESOLVED     — the traveller marked themselves safe; paging stops.
/// EXHAUSTED    — the ladder ran out of contacts/attempts/time.
/// STOPPED      — halted for another reason (recorded in `detail`).
enum SosEscalationStatus {
  RUNNING
  ACKNOWLEDGED
  RESOLVED
  EXHAUSTED
  STOPPED

  @@map("sos_escalation_status")
}

/// APPEND-ONLY audit trail: every attempt made to reach a contact about an SOS,
/// including the immediate broadcast (round 0) and each Priority escalation
/// round. Rows are never updated — "what did we actually do, and when" must
/// stay answerable afterwards.
///
/// `contactUserId` deliberately has NO foreign key: the trail records who we
/// tried to reach at the time, and must survive that account being deleted.
model SosDelivery {
  id            String             @id @default(uuid()) @db.Uuid
  sosId         String             @map("sos_id") @db.Uuid
  contactUserId String             @map("contact_user_id") @db.Uuid
  /// Position in the trusted-contact ladder (0-based). The broadcast wave uses
  /// the same positions, so the trail reads as one story per contact.
  rank          Int
  /// 0 = the immediate broadcast every SOS does; 1..n = Priority escalation rounds.
  round         Int
  /// 1-based attempt counter for this contact across the whole SOS.
  attempt       Int
  channel       SosDeliveryChannel
  status        SosDeliveryStatus
  /// Whether this attempt came from the Priority ladder (vs the standard wave).
  priority      Boolean            @default(false)
  /// Human-readable reason, shown in the traveller's SOS trail.
  detail        String?
  createdAt     DateTime           @default(now()) @map("created_at")

  sos SosEvent @relation(fields: [sosId], references: [id], onDelete: Cascade)

  @@index([sosId, createdAt])
  @@index([sosId, contactUserId])
  @@map("sos_deliveries")
}

/// Durable state of the Priority-SOS ladder for one SOS — also the queue the
/// cron sweeper drains, so a redeploy or crash cannot lose an in-flight
/// escalation the way an in-process timer would.
model SosEscalation {
  id             String              @id @default(uuid()) @db.Uuid
  sosId          String              @unique @map("sos_id") @db.Uuid
  userId         String              @map("user_id") @db.Uuid
  status         SosEscalationStatus @default(RUNNING)
  /// Entitled plan code at raise time — audit of WHY this SOS got the ladder.
  planCode       String              @map("plan_code")
  /// Whether plan enforcement was on at raise time.
  enforced       Boolean             @default(false)
  /// Frozen ladder: consenting contact userIds, in the order they are paged.
  /// `@default([])` is load-bearing: the column really does carry
  /// `DEFAULT ARRAY[]::TEXT[]` (written by hand in 20260725140000), and without
  /// it here every `migrate diff` proposes dropping that default. See the
  /// "hand-written objects" note at the top of this file.
  contactOrder   String[]            @default([]) @map("contact_order")
  /// Current ladder position (index into `contactOrder`).
  rank           Int                 @default(0)
  /// Attempts already made at `rank` (drives the retry backoff).
  attempt        Int                 @default(0)
  /// Attempts made across the whole ladder — the absolute "stop paging" cap,
  /// and the `round` stamped on the next trail row (round 0 = the broadcast).
  totalAttempts  Int                 @default(0) @map("total_attempts")
  /// When the sweeper should act next. NULL once the ladder is terminal.
  nextAttemptAt  DateTime?           @map("next_attempt_at")
  acknowledgedBy String?             @map("acknowledged_by") @db.Uuid
  detail         String?
  startedAt      DateTime            @default(now()) @map("started_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  finishedAt     DateTime?           @map("finished_at")

  sos SosEvent @relation(fields: [sosId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@map("sos_escalations")
}

// ─────────────────────────────── billing ───────────────────────────────

// Monetization catalog (build plan §20). Plans are DATA, not an enum in three
// codebases: pricing and copy change with one seeded row, no app/web/API
// redeploy. Only 'free' and 'premium' exist today — B2B tiers come later.
// `priceAmountMinor` is the smallest currency unit (cents) so money is never a
// float; 0 means free.
model Plan {
  id               String   @id @default(uuid()) @db.Uuid
  code             String   @unique
  name             String
  description      String
  priceAmountMinor Int      @default(0) @map("price_amount_minor")
  currency         String   @default("USD")
  /// Billing cadence of the price above — 'month' for every plan we sell today.
  interval         String   @default("month")
  /// Marketing bullet list, rendered verbatim by the app and the website.
  /// `@default([])` matches the hand-written `DEFAULT ARRAY[]::TEXT[]` from
  /// 20260725090000; omitting it makes every `migrate diff` propose dropping it.
  features         String[] @default([])
  isActive         Boolean  @default(true) @map("is_active")
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@index([isActive, sortOrder])
  @@map("plans")
}

// A user's CURRENT plan choice — at most one row per user, enforced in the
// database by the UNIQUE on user_id (never by app logic alone). No row at all
// means "free": we deliberately do not backfill one for every existing user.
// A paid plan can only ever be PENDING until a real payment gateway exists —
// nothing in this codebase is allowed to write ACTIVE for a paid plan.
model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @unique @map("user_id") @db.Uuid
  planId             String             @map("plan_id") @db.Uuid
  status             SubscriptionStatus @default(FREE)
  currentPeriodStart DateTime?          @map("current_period_start")
  currentPeriodEnd   DateTime?          @map("current_period_end")
  cancelAtPeriodEnd  Boolean            @default(false) @map("cancel_at_period_end")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Restrict: a plan that people are on must not be deletable out from under them.
  plan Plan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([planId])
  @@map("subscriptions")
}

// ─────────────────────── family / group plan (§20) ───────────────────────
//
// PRIVACY CONTRACT — read before adding a column or a query here.
//
// A group is a ROSTER. Being in one, on its own, exposes NOTHING about a
// member beyond their display name and avatar. It grants no location, no
// trip (live or past), no presence, no SOS visibility, no email and no phone.
// There is deliberately NO foreign key from any group table to trips, points,
// presence or SOS.
//
// Location sharing keeps flowing exclusively through TrustedContact plus the
// mutual-consent gate (UsersService.filterConsentingContactUserIds): both
// people must have added each other. A group can therefore only ever NARROW
// that audience (an intersection), never widen it. Anything that fans a
// location out to "the group" must go through
// GroupsService.getConsentingGroupMemberUserIds, which is exactly that
// intersection.
//
// Seats come from the OWNER's plan (`familyMembers`: free 0, premium 6,
// owner included) and are REPORTED, not applied, while ENFORCE_PLAN_LIMITS is
// off — which is the shipping state.

/// One family/group plan. At most one per owner (UNIQUE on owner_id): seats are
/// a per-plan resource, so N groups × N seats would make the limit meaningless.
model Group {
  id        String   @id @default(uuid()) @db.Uuid
  /// The account whose plan supplies the seats. Also holds an OWNER member row.
  ownerId   String   @unique @map("owner_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Cascade: deleting an account disbands the group it owns, and takes the
  // roster and every outstanding invitation with it (GDPR delete stays a
  // single user.delete).
  owner   User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members GroupMember[]
  invites GroupInvite[]

  @@map("groups")
}

/// A user's seat in a group. A row EXISTS only because that user accepted an
/// invitation (or created the group) — nobody is ever added by email alone.
model GroupMember {
  id       String          @id @default(uuid()) @db.Uuid
  groupId  String          @map("group_id") @db.Uuid
  userId   String          @map("user_id") @db.Uuid
  role     GroupMemberRole @default(MEMBER)
  joinedAt DateTime        @default(now()) @map("joined_at")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One seat per user per group — enforced by the database, not app logic, so a
  // double-accept race can never consume two seats.
  @@unique([groupId, userId])
  @@index([userId])
  @@map("group_members")
}

/// An INVITATION — an offer, not a membership. It carries only the invited
/// email address and NO foreign key to a user account, on purpose:
///
///  • inviting must never reveal to the inviter whether that address has a
///    RoamWarden account (account enumeration), and
///  • an unanswered invitation must never link a real person to a group they
///    have not agreed to join.
///
/// The row becomes a membership only when a signed-in user whose OWN verified
/// email matches accepts it.
model GroupInvite {
  id          String            @id @default(uuid()) @db.Uuid
  groupId     String            @map("group_id") @db.Uuid
  /// Normalised (trimmed + lowercased) — matched against users.email exactly.
  email       String
  status      GroupInviteStatus @default(PENDING)
  /// Invitations rot: an unanswered one stops being actionable after this.
  /// Expiry is COMPUTED at read time — no cron, nothing to fall behind on.
  expiresAt   DateTime          @map("expires_at")
  respondedAt DateTime?         @map("responded_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  // One invitation row per address per group, for the lifetime of the group:
  // re-inviting after a decline/revoke RESETS this row rather than piling up
  // history a user cannot see or clear.
  @@unique([groupId, email])
  // "Which groups have invited me?" — the invitee's inbox query.
  @@index([email, status])
  @@map("group_invites")
}
