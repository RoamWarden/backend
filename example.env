# ============ Server ============
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000
# Comma-separated allowed browser origins (Expo dev server, landing site dev
# server). The ORIGIN of WEB_APP_URL is ALWAYS allowed on top of whatever is
# listed here, so the deployed account site never needs listing twice — set
# WEB_APP_URL correctly in production and the site can always reach the API.
CORS_ORIGINS=http://localhost:8081,http://localhost:4321
# Trust the X-Forwarded-For header (real client IP) for rate limiting. Leave
# unset in local dev; set to true only when a known proxy (Render/Fly/ALB)
# fronts the app. Auto-enabled when NODE_ENV=production.
TRUST_PROXY=false

# ============ Database — PostgreSQL + PostGIS ============
# Local dev: install Postgres with the PostGIS extension, then CREATE EXTENSION postgis;
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/roamwarden

# ============ Redis (Pub/Sub + GEO) ============
REDIS_URL=redis://localhost:6379

# ============ Auth — JWT ============
# Generate strong random secrets: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Scoped tokens for trusted-contact live-trip share links
TRIP_SHARE_TOKEN_SECRET=
TRIP_SHARE_TOKEN_TTL=24h

# ============ Google Cloud (console.cloud.google.com) ============
# OAuth 2.0 client IDs — used server-side to verify Google Sign-In ID tokens (audience check)
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
# Server-side Maps Platform key (Directions, Geocoding, Places, Roads) — restrict by API + IP
GOOGLE_MAPS_SERVER_API_KEY=

# ============ AI APIs (optional — AI features degrade gracefully when absent) ============
# Groq API key for voice transcription (Whisper) and text classification
GROQ_API_KEY=
# Google Cloud Vision API key — used for image analysis in AI incident reporting
# Can reuse GOOGLE_MAPS_SERVER_API_KEY if it has Vision API access enabled
GOOGLE_CLOUD_API_KEY=

# ============ Firebase Admin — push notifications (FCM; APNs configured inside Firebase) ============
# From Firebase console > Project settings > Service accounts > Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private key with newlines escaped as \n
FIREBASE_PRIVATE_KEY=

# ============ Monitoring ============
SENTRY_DSN=

# ============ Email (Brevo) ============
# Primary provider. Create a key at https://app.brevo.com (Settings → SMTP & API →
# API Keys). Without any provider, emails (password reset, welcome, waitlist,
# verification code) are logged instead of sent.
BREVO_API_KEY=
# Optional — override the Brevo API base URL (defaults to https://api.brevo.com).
BREVO_API_BASE_URL=
# Legacy SMTP fallback (used only if BREVO_API_KEY is unset). smtp://user:pass@host:587
SMTP_URL=
# Sender. The email MUST be a sender/domain you've VERIFIED in Brevo, or sends are rejected.
MAIL_FROM="RoamWarden <no-reply@roamwarden.com>"
# Base URL of the website (a trailing slash is stripped). Hosts the password-reset
# page (link points here ?token=...) AND the subscription account area the app hands
# users off to (/account?handoff=...). Defaults to API_BASE_URL.
# The account area is a browser page calling this API cross-origin. Its origin is
# added to the CORS allow-list automatically (see main.ts), so setting this
# correctly in production is what lets the deployed site talk to the API at all.
# e.g. https://website-2gfg.onrender.com
WEB_APP_URL=http://localhost:4321

# ============ Rate limiting ============
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ============ Plans & entitlements (build plan §20) ============
# MASTER SWITCH for plan-limit ENFORCEMENT. Accepts only "true" or "false"
# (anything else fails at boot with a clear message); unset means false.
#
# LEAVE THIS FALSE. There is no payment gateway, so nobody can hold an ACTIVE
# paid subscription — enforcing today would cap and block people who have no way
# to upgrade. While it is false:
#   - nothing is capped, hidden, locked or removed anywhere; every user keeps
#     everything they can do today;
#   - GET /billing/entitlements still reports every limit, with enforced=false,
#     so the app can SHOW what Free vs Premium includes;
#   - every check that WOULD have blocked is logged at debug, tagged
#     "[plan-limits][shadow]" — grep those to measure the impact before flipping
#     this to true (set the log level to debug to see them).
# Flip to true only once checkout is live. The numbers themselves are code:
# src/common/entitlements/entitlement.constants.ts.
ENFORCE_PLAN_LIMITS=false

# ============ SOS escalation ladder ============
# MASTER SWITCH for re-paging trusted contacts after an unanswered SOS. Accepts
# only "true" or "false" (anything else fails at boot); unset means false.
#
# LEAVE THIS FALSE UNTIL A CLIENT CAN ACKNOWLEDGE AN ESCALATION. The ladder has
# exactly two stop conditions — the traveller resolving their SOS
# (POST /sos/:id/resolve) and a trusted contact acknowledging it
# (POST /sos/:id/ack) — and the shipped app calls neither. Armed, every SOS would
# therefore run to exhaustion and end by pushing the traveller "No one has
# answered your SOS", which the server cannot know: the contacts have no way to
# answer in-app yet. Ship the resolve/ack UI first, then flip this.
#
# While it is false, SOS is UNCHANGED and undiminished for every user:
#   - every consenting trusted contact is still alerted at once, immediately;
#   - the delivery trail is still written for everyone, so GET /sos/:id/trail
#     still answers and a withdrawal still stands the right people down;
#   - the only thing that does not happen is re-paging.
SOS_ESCALATION_ENABLED=false

